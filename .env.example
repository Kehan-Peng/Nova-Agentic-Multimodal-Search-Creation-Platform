# Copy to .env and replace the external-service values marked change-me. Provider
# services must be real; CamCat deliberately has no mock/fallback provider.
CAMCAT_DATABASE_URL=postgresql+psycopg://camcat:camcat@postgres:5432/camcat
CAMCAT_OBJECT_STORE_ENDPOINT=http://minio:9000
# Bailian fetches video by signed URL, so this must be an Internet-reachable
# HTTPS reverse proxy or S3-compatible public endpoint for full video workflows.
CAMCAT_OBJECT_STORE_PUBLIC_ENDPOINT=https://change-me-public-media.example.com
# Optional infra/compose.media.yml: owned hostname only, without scheme or path.
# Must match the hostname above and have public DNS/ports 80 and 443 configured.
CAMCAT_MEDIA_DOMAIN=
CAMCAT_OBJECT_STORE_ACCESS_KEY=camcat
CAMCAT_OBJECT_STORE_SECRET_KEY=change-me-minio-secret
CAMCAT_OBJECT_STORE_BUCKET=camcat
CAMCAT_MILVUS_URI=http://milvus:19530
CAMCAT_MILVUS_TOKEN=
CAMCAT_MILVUS_COLLECTION=camcat_segments_v7

# local-single-user ignores browser X-User-Id and binds all data to LOCAL_USER_ID.
# multi-user requires identity headers from a trusted reverse proxy plus both secrets.
CAMCAT_SECURITY_MODE=local-single-user
CAMCAT_LOCAL_USER_ID=camcat-local-user
CAMCAT_TRUSTED_PROXY_SECRET=
CAMCAT_LIBRARY_ADMIN_KEY=

# CamCat's lightweight adapter calls Bailian's hosted models. No local GPU/model
# deployment is required. Use a workspace root such as https://<workspace>.maas.aliyuncs.com.
# The public object-store endpoint must be reachable by Bailian for video URL inputs.
# Optional in local-single-user mode. Set a strong private value in multi-user mode.
CAMCAT_PROVIDER_GATEWAY_API_KEY=
CAMCAT_BAILIAN_API_HOST=https://change-me.cn-beijing.maas.aliyuncs.com
CAMCAT_BAILIAN_API_KEY=change-me-rotated-bailian-key

# These default to the Compose provider-gateway. Override only for another adapter
# implementing docs/provider-contract.md.
CAMCAT_EMBEDDING_BASE_URL=http://provider-gateway:8010
# Leave these internal API keys empty to inherit CAMCAT_PROVIDER_GATEWAY_API_KEY.
CAMCAT_EMBEDDING_API_KEY=
CAMCAT_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
CAMCAT_EMBEDDING_DIMENSION=2048
CAMCAT_EMBEDDING_VIDEO_FPS=1.0
CAMCAT_JOB_LEASE_SECONDS=600

# Qwen3-VL-Reranker gateway contract: docs/provider-contract.md
CAMCAT_RERANKER_BASE_URL=http://provider-gateway:8010
CAMCAT_RERANKER_API_KEY=
CAMCAT_RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-8B

# OpenAI-compatible Qwen chat endpoint plus CamCat's direct video description route.
CAMCAT_LLM_BASE_URL=http://provider-gateway:8010
CAMCAT_LLM_API_KEY=
CAMCAT_LLM_MODEL=qwen3-vl-plus

# OpenAI-compatible transcription endpoint.
CAMCAT_ASR_BASE_URL=http://provider-gateway:8010
CAMCAT_ASR_API_KEY=
CAMCAT_ASR_MODEL=qwen3-asr-flash

# Optional Pixabay search importer. Without it, the seed script uses the real
# short sample explicitly published in Pixabay's API documentation.
PIXABAY_API_KEY=change-me

# Frontend build/runtime values. Keep API base empty in Compose so the browser
# uses the Nginx same-origin /api proxy. Set http://127.0.0.1:8000 only for
# `npm run dev` outside Compose.
VITE_CAMCAT_API_BASE=
VITE_CAMCAT_USER_ID=camcat-local-user
